                  "name": "[[var:api_endpoint]]"
                }
              ],
              "shell_commands": [
                "cd /workspace/deepseek-agent && npx jest [[var:test_file]]",
                "cd /workspace/deepseek-agent && npx eslint [[var:source_file]]"
              ]
            },
            "instructions": "Execute the shell commands in order. If any command fails, pause and report.",
